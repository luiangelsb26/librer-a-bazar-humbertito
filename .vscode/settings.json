{
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.py[cod]": true,
        "**/venv": true,
        "**/.venv": true,
        "**/.streamlit/secrets.toml": true,
        "**/data/*.db": true,
        "**/datamkdir": true,
        "**/app_backup.py": true,
        "**/.angular": true,
        "**/.next": true,
        "**/node_modules": true,
        "**/data/*.joblib": true,
        "web/public/angular-inventory": true,
        "public/angular-inventory": true,
        "tmp": true
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/venv": true,
        "**/.venv": true,
        "**/.streamlit/secrets.toml": true,
        "**/data/*.db": true,
        "**/datamkdir": true,
        "**/app_backup.py": true,
        "**/.angular": true,
        "**/.next": true,
        "**/node_modules": true,
        "**/data/*.joblib": true,
        "web/public/angular-inventory": true,
        "public/angular-inventory": true,
        "tmp": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python.analysis.useLibraryCodeForTypes": true,
    "python.analysis.typeCheckingMode": "basic"
}
